# ==========================================================
# PHISFAIL Backend Environment Configuration Example
# ==========================================================

# Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
RATE_LIMIT_PER_MINUTE=60

# Google Gemini API (For Live Conversational AI Investigator)
# Get key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Threat Intelligence: VirusTotal v3 API
# Get key: https://www.virustotal.com/
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Threat Intelligence: Google Safe Browsing API v4
# Get key: https://console.cloud.google.com/apis/credentials
GOOGLE_SAFE_BROWSING_API_KEY=your_safe_browsing_key_here

# Supabase PostgreSQL (Optional: Falls back to local JSON store if empty)
# Get keys: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_role_key

